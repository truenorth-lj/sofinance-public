        "wallet",
        "positionMint",
      ],
      "type": "object",
    },
    "name": "prepare_withdraw",
  },
  {
    "description": "Submit a wallet signed withdrawal. Verifies its HMAC permit and signature, checks expiry, and re-simulates before broadcast. Supply the unchanged summary and permit from prepare_withdraw. If the wallet appended extra instructions (e.g. Phantom Lighthouse), also pass unsignedTransaction from prepare_withdraw. High impact requires confirmHighImpact=true.",
    "inputSchema": {
      "properties": {
        "confirmHighImpact": {
          "type": "boolean",
        },
        "permit": {
          "type": "string",
        },
        "signedTransaction": {
          "type": "string",
        },
        "summary": {
          "type": "object",
        },
        "unsignedTransaction": {
          "type": "string",
        },
        "wallet": {
          "type": "string",
        },
      },
      "required": [
