{
  "name": "sofinance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:engine",
    "test": "pnpm test:app && pnpm test:engine",
    "test:env-matrix": "bash scripts/test-env-matrix.sh",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "mcp:start": "tsx src/mcp/server.ts",
    "mcp:dev": "tsx watch src/mcp/server.ts",
    "build:rwa-service": "esbuild scripts/rwa-data-service.ts --bundle --platform=node --format=cjs --outfile=dist/rwa-data-service.cjs --alias:server-only=./src/mcp/server-only-mock-impl.js",
    "db:generate": "drizzle-kit generate",
    "db:baseline": "node --env-file-if-exists=.env.local --import tsx scripts/rwa-migrate.ts baseline",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/rwa-migrate.ts migrate",
    "test:app": "vitest run",
    "test:engine": "pnpm --filter @sofinance/engine test",
    "typecheck:app": "tsc --noEmit --incremental false",
    "typecheck:engine": "pnpm --filter @sofinance/engine typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-slot": "^1.5.0",
    "@raydium-io/raydium-sdk-v2": "0.2.74-alpha",
    "@reown/appkit": "1.8.24",
    "@reown/appkit-adapter-solana": "1.8.24",
    "@reown/appkit-wallet-button": "1.8.24",
    "@sentry/nextjs": "^11.9.0",
    "@sofinance/engine": "workspace:*",
    "@solana/spl-token": "0.4.15",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-react": "0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/web3.js": "1.99.0",
    "bn.js": "^5.2.5",
    "bs58": "6.0.0",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "0.45.4",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "postgres": "3.4.7",
    "posthog-js": "^1.438.21",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "happy-dom": "^21.0.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.18.2",
  "license": "MIT"
}
