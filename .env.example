# Keep any credential-bearing RPC URL on the server only.
# Server RPC (API routes, libs, MCP) always goes through src/lib/rpc/:
# Solami (if SOLAMI_API_KEY) → SOLANA_RPC_URL → public mainnet.
# 429 / 5xx / timeouts retry with jittered backoff, then fail over.
# Safe reads (account/tx/mint) are cached in-process with short TTLs.
# SOFINANCE_RPC_LOG=1 writes key-free JSON lines (provider, method, status,
# retries, cache hit) to the server log — useful on Vercel. Off by default.
# Also enables Jupiter client logs. SOFINANCE_JUPITER_LOG=1 enables those alone.
SOFINANCE_RPC_LOG=
SOFINANCE_JUPITER_LOG=
SOLANA_RPC_URL=

# Optional Solami keys (server-only). Never prefix with NEXT_PUBLIC_.
# SOLAMI_API_KEY: standard key for RPC https://rpc.solami.dev/sol?api_key=…, gRPC, Beam.
# When set, the server uses Solami as the primary JSON-RPC provider
# and prepare flows may add a Beam tip (100k lamports) before HMAC binding.
# Set SOLAMI_BEAM=0 to keep the Solami RPC but skip tips.
SOLAMI_API_KEY=
SOLAMI_BEAM=

# SOLAMI_DATA_API_KEY: DataApi-only key for Blur REST/WS at https://api.solami.dev/data/…
# (header x-api-key or ?api_key=). Powers /api/pool-activity and the live ticker.
# A Free key does not include WebSocket; Pro (incl. 7-day promo) does.
SOLAMI_DATA_API_KEY=

# Optional browser-facing RPC URL. NEXT_PUBLIC_ values are bundled into browser code:
# use only an endpoint intended to be public, never a private provider API key.
# When blank, the wallet adapter uses Solana's public RPC; zap broadcast uses SOLANA_RPC_URL on the server.
NEXT_PUBLIC_SOLANA_RPC_URL=

# Server-only. Never prefix this key with NEXT_PUBLIC_.
# Portal key for https://api.jup.ag via the x-api-key header (not lite-api).
# Used for Jupiter swap quotes, permit HMACs, and sign token HMACs.
# All Jupiter HTTP goes through src/lib/jupiter/ (429/5xx retry, quote cache).
JUPITER_API_KEY=

# Optional protocol swap fee (server-only, never NEXT_PUBLIC_).
# SOFINANCE_FEE_WALLET: Solana address that receives the fee inside the same
# user-signed v0 transaction. Unset = fee 0, behavior identical to today.
# SOFINANCE_FEE_BPS: basis points of each executed swap input (default 10, max 100).
SOFINANCE_FEE_WALLET=
SOFINANCE_FEE_BPS=

# Public Reown project ID for Solana wallet connect (WalletConnect QR + browser extensions).
# Create one at https://dashboard.reown.com/; this is not a wallet secret.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Public app URL for MCP connection URLs and sign deep-links.
# Auto-detected from VERCEL_URL in production. For local dev, set to http://localhost:3000
# Required for MCP server to generate absolute URLs (e.g., https://sofinancelab.xyz/api/mcp, /app/sign/<token>)
NEXT_PUBLIC_APP_URL=
